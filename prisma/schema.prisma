// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // a URL real é resolvida em tempo de build/deploy (vercel.json) e no db.ts
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Pedido da loja — árvore de Natal
model Order {
  id               String    @id @default(cuid())
  code             String    @unique
  // Fluxo "Pix primeiro": o pedido nasce SEM dados do cliente (o Pix é
  // emitido na hora) e o nome/contato/endereço entram depois do pagamento.
  customerName     String?
  cpf              String? // CPF do pagador (emitido na cobrança Pix)
  phone            String?
  cep              String?
  street           String?
  number           String?
  complement       String?
  neighborhood     String?
  city             String?
  state            String?
  quantity         Int       @default(1)
  lightsKit        Boolean   @default(false)
  paymentMethod    String    @default("pix")
  notes            String?
  totalValue       Float     @default(80)
  status           String    @default("novo") // novo | aguardando_pagamento | pago | enviado | entregue
  // dados da cobrança Pix (MisticPay)
  pixTransactionId String? // ID da transação na MisticPay
  pixCopyPaste     String? // código Pix copia e cola
  paidAt           DateTime? // quando o Pix foi confirmado
  // 🚚 envio e prazo de entrega (controlados pelo painel admin)
  deliveryDays     Int? // prazo de entrega informado pelo admin (em dias)
  deliveryNote     String? // observação do envio (ex.: transportadora, rastreio)
  shippedAt        DateTime? // quando o pedido foi marcado como enviado
  deliveredAt      DateTime? // quando o pedido foi marcado como entregue
  createdAt        DateTime  @default(now())
}